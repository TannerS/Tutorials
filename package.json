{
  "name": "tutorials",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173 --strictPort",
    "build": "tsc && vite build",
    "lint": "eslint .",
    "preview": "vite preview --port 5173",
    "typecheck": "tsc --noEmit",
    "build:pdf": "npm run build && node scripts/build-pdf.mjs",
    "build:pdf:combined": "npm run build && node scripts/build-pdf.mjs --combined",
    "build:pdf:dark": "npm run build && node scripts/build-pdf.mjs --combined --dark",
    "build:pdf:cheatsheets": "npm run build && node scripts/build-pdf.mjs --cheatsheets",
    "build:pdf:cheatsheets:dark": "npm run build && node scripts/build-pdf.mjs --cheatsheets --dark",
    "pdf:section": "node scripts/build-pdf.mjs"
  },
  "dependencies": {
    "@codesandbox/sandpack-react": "^2.20.0",
    "@typescript/vfs": "^1.6.0",
    "mermaid": "^11.15.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.16.0",
    "react-syntax-highlighter": "^16.1.1",
    "sass": "^1.102.0",
    "sql.js": "^1.14.1",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^10.4.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.57.0",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.0.14"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@10.9.0"
}
