{
  "name": "tutorials-monorepo",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --filter=@tutorials/site",
    "build": "turbo run build --filter=@tutorials/site",
    "lint": "turbo run lint --filter=@tutorials/site",
    "typecheck": "turbo run typecheck --filter=@tutorials/site",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "turbo": "^2.9.16",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@10.9.0"
}
